# Server
PORT=3000
BACKEND_PUBLIC_URL=https://your-backend.example
DASHBOARD_PUBLIC_URL=https://your-name.github.io/your-repo/#/settings
DASHBOARD_ORIGIN=https://your-name.github.io

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# Optional: choose a specific Page if the user manages several pages
FB_PAGE_ID=

# Threads (can be separate app credentials)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Security
OAUTH_STATE_SECRET=replace-with-a-long-random-string
SCHEDULE_SYNC_KEY=replace-with-another-long-random-string

# Optional direct tokens (alternative to OAuth for controlled testing)
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
THREADS_ACCESS_TOKEN=

# Runtime files. Use persistent storage when your host supports it.
SOCIAL_DATA_FILE=./data/social-runtime.json
SOCIAL_TOKEN_FILE=./data/social-tokens.json

# Maximum recent items fetched per platform in one sync (1-2000)
SOCIAL_SYNC_MAX_ITEMS=500
